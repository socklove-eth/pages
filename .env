# Committed: no secrets, and a build input (changes the CID).
# Tried in order, ranked by what each operator keeps: nothing first, then the
# shortest retention; a decentralised network leads. Each from a different
# operator, keyless, passing a browser CORS preflight and answering every call
# Altar makes.
RPC_URLS=https://eth.api.pocket.network,https://0xrpc.io/eth,https://ethereum-rpc.publicnode.com,https://rpc.mevblocker.io,https://ethereum-json-rpc.stakely.io,https://rpc-eth.blockmachine.io,https://eth.drpc.org,https://ethereum.public.blockpi.network/v1/rpc/public,https://rpc.swiftnodes.io/rpc/eth,https://mainnet.rpc.sentio.xyz

# What the page acts on. The build refuses anything but a .eth name, a plain
# label and checksummed addresses.
ENS_NAME=socklove.eth
ENS_LABEL=sockthief
ENS_REGISTRY_WITH_FALLBACK=0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e
ENS_PUBLIC_RESOLVER=0xF29100983E058B709F3D539b0c765937B804AC15
SAFE_MULTI_SEND_CALL_ONLY=0x9641d764fc13c8B624c04430C7356C1C7C8102e2
# The Safe itself: once it is 2-of-2, the Page says so whatever the name does.
SAFE=0x0857293192bF97Ee73bB471c185E1933Fa51E0ca
